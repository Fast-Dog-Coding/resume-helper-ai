# Use this file as a model to create a .env file in the same (root) folder.
# Replace the placeholders with actual values from your OpenAI and MongoDB
# accoounts.

# App Identity
APP_TITLE="Resume Assistant"
APP_HTTP_REFERER="<YOUR_APP_HTTP_REFERER>"

# OpenRouter
OPENROUTER_API_KEY="<YOUR_OPENROUTER_API_KEY>"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODELS="<YOUR_OPENROUTER_MODELs>" # "[\"google/gemini-2.5-flash\",\"openai/gpt-4.1-mini\"]"

# Mongo Atlas
MONGODB_CONNECTION="mongodb+srv://...mongodb.net/?retryWrites=true&w=majority&appName=..."
MONGODB_DB_NAME="<YOUR_DB_NAME>"

# Encryption
COOKIE_ENCRYPTION_KEY="<32_BYTE_HEX_STRING>" # e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Rate Limits
RATE_LIMIT_WINDOW_MS="300000" # 5 minutes
RATE_LIMIT_AMOUNT="20" # 4 requests per minute per IP
RATE_LIMIT_PROXY="1" # number of proxies between user and server.

# Logging
LOG_LEVEL="info"
